datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         String   @default("customer")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  notifications    NotificationPreference?
  quotes           Quote[]
  shipments        Shipment[]
  claims           Claim[]
  paymentMethods   PaymentMethod[]
  invoices         Invoice[]
  spotRates        SpotRateRequest[]
  fedexConnections FedexAccountConnection[]
  twoFactorCodes   TwoFactorCode[]
}

model Company {
  id           String   @id @default(uuid())
  name         String
  country      String
  province     String?
  city         String?
  postalCode   String?
  shippingType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

model NotificationPreference {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id])
  shipmentBooked     Boolean @default(true)
  outForDelivery     Boolean @default(true)
  delivered          Boolean @default(true)
  exceptionsDelays   Boolean @default(true)
  spotRateResponses  Boolean @default(true)
  claimsUpdates      Boolean @default(true)
  promotional        Boolean @default(false)
}

model Quote {
  id           String @id @default(uuid())
  quoteNumber  String @unique
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  shipmentType  String
  originCity    String?
  originPostal  String
  originCountry String
  destCity      String?
  destPostal    String
  destCountry   String
  weight        Float
  pieces        Int      @default(1)
  dimL          Float?
  dimW          Float?
  dimH          Float?
  freightClass  String?
  currency      String   @default("CAD")
  pickupDate    String?
  declaredValue Float?
  commodity     String?
  accessorials  String?

  rates     QuoteRate[]
  expiresAt DateTime
  status    String   @default("active")
  createdAt DateTime @default(now())

  shipment Shipment?
}

model QuoteRate {
  id          String @id @default(uuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id])

  carrierId         String
  carrierName       String
  serviceName       String
  baseRate          Float
  displayRate       Float
  transitDays       Int
  estimatedDelivery String?
  isLiveRate        Boolean @default(false)
  isBestRate        Boolean @default(false)
}

model Shipment {
  id             String @id @default(uuid())
  trackingNumber String @unique
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  quoteId        String? @unique
  quote          Quote?  @relation(fields: [quoteId], references: [id])

  carrierId      String
  carrierName    String
  serviceName    String
  shipmentType   String
  originCity     String?
  originPostal   String
  originCountry  String
  destCity       String?
  destPostal     String
  destCountry    String
  weight         Float
  pieces         Int
  dimL           Float?
  dimW           Float?
  dimH           Float?
  freightClass   String?
  currency       String  @default("CAD")
  declaredValue  Float?
  commodity      String?
  accessorials   String?

  baseRate    Float
  displayRate Float

  status            String   @default("pending")
  estimatedDelivery String?
  actualDelivery    String?

  bookedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackingEvents TrackingEvent[]
  claims         Claim[]
  invoiceItems   InvoiceItem[]
}

model TrackingEvent {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])

  event       String
  location    String
  timestamp   DateTime
  description String?

  createdAt DateTime @default(now())
}

model Claim {
  id          String @id @default(uuid())
  claimNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])

  trackingNumber  String
  carrierId       String
  carrierName     String
  claimType       String
  shipmentDate    String?
  amountClaimed   Float
  currency        String  @default("CAD")
  commodity       String?
  description     String
  additionalNotes String?
  documents       String?

  status      String   @default("open")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentMethod {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id])

  type        String
  last4       String
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
}

model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique
  userId        String
  user          User   @relation(fields: [userId], references: [id])

  totalAmount Float
  currency    String @default("CAD")
  status      String @default("pending")

  issuedAt DateTime @default(now())
  paidAt   DateTime?

  items InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  shipmentId  String?
  shipment    Shipment? @relation(fields: [shipmentId], references: [id])

  description String
  amount      Float
}

model SpotRateRequest {
  id            String @id @default(uuid())
  requestNumber String @unique
  userId        String
  user          User   @relation(fields: [userId], references: [id])

  shipmentType  String
  originCity    String?
  originPostal  String?
  originCountry String
  destCity      String?
  destPostal    String?
  destCountry   String
  originPort    String?
  destPort      String?
  oceanType     String?

  weight        Float?
  pieces        Int?
  dimensions    String?
  pickupDate    String?
  commodity     String?
  declaredValue Float?
  specialNotes  String?

  status     String   @default("pending")
  quotedRate Float?
  quotedAt   DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// FedEx Integrator "End User registration" — connecting a customer's own FedEx
// account via Factor 1 (account number + address) + Factor 2 MFA (PIN or invoice).
// Mocked: no live FedEx Account Registration API call is made yet.
model FedexAccountConnection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  fedexAccountNumber String
  shippingAddress    String // JSON-encoded { street, city, province, postalCode, country }
  eulaAcceptedAt      DateTime

  status        String  @default("awaiting_factor2") // awaiting_factor2 | verified | failed | locked
  factor2Method String? // pin_email | pin_sms | pin_call | invoice

  pinCodeHash String?
  pinExpiresAt DateTime?

  attempts    Int       @default(0)
  lockedUntil DateTime?

  childKey    String?
  childSecret String?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Second factor for login — a short-lived, bcrypt-hashed 6-digit code emailed
// (mocked via console.log in dev) after a correct password.
model TwoFactorCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())
}
